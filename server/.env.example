# Jarvis backend environment variables (copy to .env.local for local dev,
# and set the same names in Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# --- Required -------------------------------------------------------------
# Bearer token the Android app must present. One or more, comma separated,
# so you can roll tokens without breaking installed clients.
# Generate: openssl rand -hex 32
JARVIS_API_TOKEN=

# --- LLM providers (set at least one) -------------------------------------
# Registry + free-tier notes: server/lib/providers.js
# The app never sees these keys and end users never enter one.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
ZAI_API_KEY=
OPENROUTER_API_KEY=
# Optional keys: these providers also work anonymously / with a free token.
LLM7_API_KEY=
OVH_AI_TOKEN=
# Cloudflare Workers AI needs both values.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Optional: durable cloud sync -----------------------------------------
# Without these the API still works and reports storage="memory"; the phone
# keeps all tasks locally either way.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional tuning ------------------------------------------------------
# Restrict the router to specific provider slugs, e.g. "groq,gemini".
JARVIS_PROVIDER_ALLOWLIST=
# Public origin used for OpenRouter attribution headers.
APP_ORIGIN=
